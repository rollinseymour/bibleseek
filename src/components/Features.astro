---
/**
 * Six-card grid summarising what's actually inside the app. Pulled from
 * the iOS app's release-note bullets so the marketing message and the
 * in-app "What's New" popup stay in sync.
 *
 * Icons are inline SVGs — no icon font, no JS, no extra HTTP request.
 * Each entry's `icon` is the SVG path content; the wrapper applies
 * the colour and sizing.
 */

interface Feature {
  title: string;
  body: string;
  /** Inner content of an SVG with viewBox="0 0 24 24". */
  icon: string;
}

const features: Feature[] = [
  {
    title: "Read offline",
    body:
      "King James + American Standard translations bundled in the app. No network? No problem. No account? No problem.",
    icon:
      '<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5V4.5Z"/><path d="M4 19.5V21a1 1 0 0 0 1 1h15"/>',
  },
  {
    title: "Tap any verse",
    body:
      "Highlight, take a note, copy, share, compare ↔ versions, see added related cross-references, or add as memory verse.",
    icon:
      '<path d="M9 11V6a3 3 0 0 1 6 0v5"/><path d="M5 11h14l-1.5 9a2 2 0 0 1-2 1.7H8.5a2 2 0 0 1-2-1.7L5 11Z"/>',
  },
  {
    title: "Word study",
    body:
      "Hold down on any word in KJV to look up its Hebrew or Greek root, definition, transliteration, and part of speech.",
    icon:
      '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  },
  {
    title: "Custom reading plans",
    body:
      "Build your own schedule — by book, chapter, or topic. Get optional daily reminders. Today's reading surfaces on the home screen.",
    icon:
      '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  },
  {
    title: "Memory verses",
    body:
      "Active recall, not passive reading: tap the correct words to fill in the verse before the app marks it memorized.",
    icon:
      '<path d="M9 5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H9Z"/><path d="M9 9h6M9 13h4"/>',
  },
  {
    title: "Yours, everywhere on iOS",
    body:
      "Highlights, notes, and bookmarks are searchable from iOS Spotlight. Today's verse on a home-screen widget. Journal export to PDF.",
    icon:
      '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/>',
  },
];
---

<section id="features" class="border-t border-divider bg-cream-2/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-widest uppercase text-accent">
        What's inside
      </p>
      <h2
        class="mt-3 font-serif text-3xl sm:text-4xl font-bold text-ink leading-tight"
      >
        A study companion that respects your time and the scriptures.
      </h2>
      <p class="mt-4 text-ink-soft text-base leading-relaxed">
        Bible Seek is built around the way people should read scripture:
        diligently, with notes, returning to the same passages
        across a lifetime.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <article class="rounded-2xl bg-cream p-6 ring-1 ring-divider hover:ring-accent/30 transition-shadow hover:shadow-sm">
            <div
              class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent"
              aria-hidden="true"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={f.icon}
              />
            </div>
            <h3 class="mt-4 font-serif text-xl font-semibold text-ink">
              {f.title}
            </h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
