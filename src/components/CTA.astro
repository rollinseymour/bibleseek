---
/**
 * Closing call-to-action — second App Store nudge for visitors who
 * scrolled all the way down. Visually stronger than the hero CTA
 * (filled accent block, large type) so it reads as the page's
 * conclusion.
 */
---

<section class="border-t border-divider">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div
      class="rounded-3xl bg-accent text-cream p-10 md:p-14 text-center relative overflow-hidden"
    >
      <!-- Soft radial highlight in the corner so the block has depth. -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(circle at 80% 0%, rgba(255,255,255,0.15), transparent 60%);"
        aria-hidden="true"
      >
      </div>

      <h2
        class="relative font-serif text-3xl sm:text-4xl md:text-5xl font-bold leading-tight"
      >
        The Word, in your pocket.
      </h2>
      <p class="relative mt-4 text-cream/85 max-w-xl mx-auto leading-relaxed">
        Free. Offline. Built by one person who wants your Bible Reader to be a reflection
        of the scripture, not just an app.
      </p>

      <a
        href="https://apps.apple.com/app/id6760152974"
        target="_blank"
        rel="noopener noreferrer"
        class="relative mt-8 inline-flex items-center gap-3 rounded-xl bg-cream text-ink pl-4 pr-5 py-3 hover:bg-cream-2 transition-colors"
      >
        <svg
          class="h-7 w-7"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516.024.034 1.52.087 2.475-1.258.955-1.345.762-2.391.728-2.43Zm3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422.212-2.189 1.675-2.789 1.698-2.854.023-.065-.597-.79-1.254-1.157a3.692 3.692 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56.244.729.625 1.924 1.273 2.796.576.984 1.34 1.667 1.659 1.899.319.232 1.219.386 1.843.067.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758.347-.79.505-1.217.473-1.282Z"
          />
        </svg>
        <span class="flex flex-col leading-tight text-left">
          <span class="text-[10px] tracking-wider uppercase text-ink-muted"
            >Download on the</span
          >
          <span class="text-base font-semibold">App Store</span>
        </span>
      </a>
    </div>
  </div>
</section>
