---
/**
 * Closing call-to-action — second App Store nudge for visitors who
 * scrolled all the way down. Visually stronger than the hero CTA
 * (filled accent block, large type) so it reads as the page's
 * conclusion.
 */
---

<section class="border-t border-divider">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div
      class="rounded-3xl bg-accent text-cream p-10 md:p-14 text-center relative overflow-hidden"
    >
      <!-- Soft radial highlight in the corner so the block has depth. -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(circle at 80% 0%, rgba(255,255,255,0.15), transparent 60%);"
        aria-hidden="true"
      >
      </div>

      <h2
        class="relative font-serif text-3xl sm:text-4xl md:text-5xl font-bold leading-tight"
      >
        The Word, in your pocket.
      </h2>
      <p class="relative mt-4 text-cream/85 max-w-xl mx-auto leading-relaxed">
        Free. Offline. Built by one person who wants your Bible Reader to be a reflection
        of the scripture, not just an app.
      </p>

      <a
        href="https://apps.apple.com/app/id6760152974"
        target="_blank"
        rel="noopener noreferrer"
        class="relative mt-8 inline-block hover:opacity-85 transition-opacity"
      >
        <img
          src="/app-store-badge.svg"
          alt="Download on the App Store"
          width="144"
          height="48"
          class="h-12 w-auto"
        />
      </a>
      <p class="relative mt-6 text-sm text-cream/85">
        Not on iPhone?
        <a
          href="/read/"
          class="font-semibold underline underline-offset-4 hover:text-cream transition-colors"
          >Read Bible Seek in your browser</a
        >
      </p>
    </div>
  </div>
</section>
