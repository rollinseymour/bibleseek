---
/**
 * Horizontally-scrolling screenshot strip. Drop bare 1290×2796 PNGs
 * at /public/screen-1.png … /public/screen-4.png; each is layered
 * inside /public/iphone-frame.png. `loading="lazy"` keeps off-screen
 * frames out of the initial paint.
 */

const screenshots = [
  { src: "/screen-1.png", alt: "Bible Seek home screen with continue reading and verse of the day" },
  { src: "/screen-2.png", alt: "John 3:16 reader view with fill-in-the-blank word tiles" },
  { src: "/screen-3.png", alt: "Word study lookup for the English word husband" },
  { src: "/screen-4.png", alt: "Journal screen listing highlights and notes" },
];
---

<section id="screenshots" class="border-t border-divider bg-cream-2/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl mb-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-accent">
        See it
      </p>
      <h2
        class="mt-3 font-serif text-3xl sm:text-4xl font-bold text-ink leading-tight"
      >
        Built to be lived in.
      </h2>
    </div>

    <div
      class="-mx-5 px-5 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 [scrollbar-width:thin]"
    >
      {
        screenshots.map((s) => (
          <div class="snap-center shrink-0 w-[220px] sm:w-[240px]">
            <div class="relative aspect-[490/990] drop-shadow-[0_20px_30px_rgba(0,0,0,0.35)]">
              <div class="absolute top-[1.11%] bottom-[1.21%] left-[2.45%] right-[2.45%] overflow-hidden rounded-[7%] bg-ink">
                {/* Shifted down by 0.92% so the iOS status bar's dynamic
                    island aligns under (and is masked by) the frame's
                    island. The screenshot's bottom ~3% gets clipped —
                    just the home indicator pill, not actual UI. */}
                <img
                  src={s.src}
                  alt={s.alt}
                  loading="lazy"
                  class="absolute left-0 top-[0.92%] w-full h-auto"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="hidden absolute inset-0 items-center justify-center text-center px-2 bg-cream-2 text-ink-muted text-[11px] leading-snug">
                  Drop a screenshot at <code class="text-accent">{s.src}</code>
                </div>
              </div>
              <img
                src="/iphone-frame.png"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full pointer-events-none"
              />
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-xs text-ink-muted">
      Swipe to see more.
    </p>
  </div>
</section>
