---
/**
 * Horizontally-scrolling screenshot strip. Each /public/screen-N.png
 * is composited inside /public/iphone-frame.png so the bezel, side
 * buttons, and Dynamic Island render on top of the screen content.
 *
 * The frame asset is 490×990 with a transparent screen area inset
 * 6.12% on the sides and 2.93% top/bottom — the screen-1..4 PNGs are
 * sized to that aspect (~0.461) so they fit cleanly with no cropping.
 * The bezel's opaque inner curve naturally masks the screenshot's
 * rectangular corners.
 *
 * On smaller screens this becomes a horizontal swipe gallery via
 * `overflow-x-auto + snap-x`. On larger screens all four sit in a
 * single row.
 */

const screenshots = [
  { src: "/screen-1.png", alt: "Bible Seek home screen with Continue Reading, Verse of the Day, and Explore tiles" },
  { src: "/screen-2.png", alt: "Memorization fill-in-the-blank for Proverbs 31:11 with a word bank at the bottom" },
  { src: "/screen-3.png", alt: "Word Study screen looking up the English word 'yoke' with Greek and Hebrew results" },
  { src: "/screen-4.png", alt: "Share as Image composer for John 15:5-6 with selectable color themes" },
];
---

<section id="screenshots" class="border-t border-divider bg-cream-2/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl mb-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-accent">
        See it
      </p>
      <h2
        class="mt-3 font-serif text-3xl sm:text-4xl font-bold text-ink leading-tight"
      >
        Built to be lived in.
      </h2>
    </div>

    <div
      class="-mx-5 px-5 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 [scrollbar-width:thin]"
    >
      {
        screenshots.map((s) => (
          <div class="snap-center shrink-0 w-[220px] sm:w-[240px]">
            <div
              class="relative w-full aspect-[490/990] [filter:drop-shadow(0_20px_30px_rgba(0,0,0,0.35))]"
            >
              {/* Screenshot fitted to the frame's transparent screen area */}
              <img
                src={s.src}
                alt={s.alt}
                loading="lazy"
                class="absolute left-[6.12%] top-[2.93%] w-[87.76%] h-[94.14%] rounded-[6%] object-cover bg-ink"
                onerror="this.style.display='none'"
              />
              {/* iPhone bezel — side rails, buttons, Dynamic Island */}
              <img
                src="/iphone-frame.png"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full pointer-events-none select-none"
              />
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-4 text-xs text-ink-muted">
      Swipe to see more.
    </p>
  </div>
</section>
