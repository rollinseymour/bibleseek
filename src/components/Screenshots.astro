---
/**
 * Horizontally-scrolling screenshot strip. Drop 1170×2532 (3x) PNGs
 * at /public/screen-1.png … /public/screen-4.png to populate. The
 * `loading="lazy"` keeps off-screen frames out of the initial paint.
 *
 * On smaller screens this becomes a horizontal swipe gallery via
 * `overflow-x-auto + snap-x`. On larger screens all four sit in a
 * single row.
 */

// `framed: true` wraps the image in a iPhone bezel — only do this for
// bare app screenshots. App Store-style marketing PNGs (with their own
// mockups + copy baked in) should set `framed: false` so they aren't
// double-framed.
const screenshots = [
  { src: "/screen-1.png", alt: "Bible Seek home screen with Continue Reading, Verse of the Day, and Explore tiles", framed: true },
  { src: "/screen-2.png", alt: "Memorization fill-in-the-blank for Proverbs 31:11 with a word bank at the bottom", framed: true },
  { src: "/screen-3.png", alt: "Word Study screen looking up the English word 'yoke' with Greek and Hebrew results", framed: true },
  { src: "/screen-4.png", alt: "Share as Image composer for John 15:5-6 with selectable color themes", framed: true },
];
---

<section id="screenshots" class="border-t border-divider bg-cream-2/40">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl mb-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-accent">
        See it
      </p>
      <h2
        class="mt-3 font-serif text-3xl sm:text-4xl font-bold text-ink leading-tight"
      >
        Built to be lived in.
      </h2>
    </div>

    <div
      class="-mx-5 px-5 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 [scrollbar-width:thin]"
    >
      {
        screenshots.map((s) =>
          s.framed ? (
            <div class="snap-center shrink-0 w-[220px] sm:w-[240px]">
              <div class="aspect-[9/19.5] rounded-[32px] bg-ink p-2 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.35)] ring-1 ring-black/10">
                <div class="h-full w-full rounded-[26px] bg-ink overflow-hidden flex items-center justify-center text-ink-muted text-[11px] text-center px-3 leading-snug">
                  <img
                    src={s.src}
                    alt={s.alt}
                    loading="lazy"
                    class="h-full w-full object-contain"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden h-full w-full items-center justify-center text-center px-2 bg-cream-2">
                    Drop a screenshot at <code class="text-accent">{s.src}</code>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <div class="snap-center shrink-0 w-[220px] sm:w-[240px]">
              <div class="aspect-[9/19.5] rounded-[24px] overflow-hidden shadow-[0_20px_50px_-15px_rgba(0,0,0,0.35)] ring-1 ring-black/10 flex items-center justify-center text-ink-muted text-[11px] text-center px-3 leading-snug">
                <img
                  src={s.src}
                  alt={s.alt}
                  loading="lazy"
                  class="h-full w-full object-contain"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="hidden h-full w-full items-center justify-center text-center px-2 bg-cream-2">
                  Drop a screenshot at <code class="text-accent">{s.src}</code>
                </div>
              </div>
            </div>
          )
        )
      }
    </div>

    <p class="mt-4 text-xs text-ink-muted">
      Swipe to see more.
    </p>
  </div>
</section>
