---
/**
 * Hero — the page's primary message + the App Store CTA. Designed to
 * fit "above the fold" on a typical phone screen so visitors see both
 * the value prop and the download button without scrolling.
 *
 * The phone on the right composites /public/hero-screenshot.png inside
 * /public/iphone-frame.png so the bezel, side buttons, and Dynamic
 * Island render on top of the screen content. Same compositing pattern
 * as Screenshots.astro — see notes there for the screen-area insets.
 */
---

<section class="relative overflow-hidden">
  <!-- Subtle radial wash so the cream background reads as intentional,
       not flat. Pinned behind everything. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(circle at 20% 0%, rgba(122, 90, 45, 0.10), transparent 55%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto max-w-6xl px-5 pt-16 pb-20 md:pt-24 md:pb-28 grid md:grid-cols-2 gap-12 md:gap-8 items-center"
  >
    <!-- Text column -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-accent">
        Bible Seek for iPhone
      </p>
      <h1
        class="mt-4 font-serif text-5xl sm:text-6xl font-bold leading-[1.05] tracking-tight text-ink"
      >
        Scripture,<br />made personal.
      </h1>
      <p class="mt-6 text-lg text-ink-soft leading-relaxed max-w-xl">
        An offline-first Bible reader with verse highlighting,
        study notes, custom reading plans, and original-language word
        studies — all on your iPhone.
      </p>

      <div id="download" class="mt-8 flex flex-wrap items-center gap-4">
        <!-- The visual "App Store" badge is rendered with CSS so we
             don't have to ship Apple's binary asset. The URL omits the
             country code so Apple auto-redirects to the visitor's
             regional store. -->
        <a
          href="https://apps.apple.com/app/id6760152974"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 rounded-xl bg-ink text-cream pl-4 pr-5 py-3 hover:bg-ink-soft transition-colors"
        >
          <svg
            class="h-7 w-7"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516.024.034 1.52.087 2.475-1.258.955-1.345.762-2.391.728-2.43Zm3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422.212-2.189 1.675-2.789 1.698-2.854.023-.065-.597-.79-1.254-1.157a3.692 3.692 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56.244.729.625 1.924 1.273 2.796.576.984 1.34 1.667 1.659 1.899.319.232 1.219.386 1.843.067.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758.347-.79.505-1.217.473-1.282Z"
            />
          </svg>
          <span class="flex flex-col leading-tight text-left">
            <span class="text-[10px] tracking-wider uppercase text-cream/70"
              >Download on the</span
            >
            <span class="text-base font-semibold">App Store</span>
          </span>
        </a>
        <p class="text-sm text-ink-muted">Free · iOS 13.0 or later</p>
      </div>
    </div>

    <!-- Visual column: iPhone-framed hero screenshot -->
    <div class="relative md:justify-self-end">
      <div
        class="relative mx-auto w-[260px] sm:w-[300px] aspect-[490/990] [filter:drop-shadow(0_30px_60px_rgba(0,0,0,0.4))]"
      >
        <!-- Screenshot fitted to the frame's transparent screen area -->
        <img
          src="/hero-screenshot.png"
          alt="Bible Seek reader showing Psalms 23"
          class="absolute left-[6.12%] top-[2.93%] w-[87.76%] h-[94.14%] rounded-[6%] object-cover bg-ink"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <!-- Fallback if the screenshot is missing — keeps the bezel intact -->
        <div
          class="hidden absolute left-[6.12%] top-[2.93%] w-[87.76%] h-[94.14%] rounded-[6%] bg-cream-2 items-center justify-center text-center text-ink-muted text-xs px-6 leading-relaxed"
        >
          Drop a screenshot at<br /><code
            class="text-accent">/public/hero-screenshot.png</code
          >
        </div>
        <!-- iPhone bezel — side rails, buttons, Dynamic Island -->
        <img
          src="/iphone-frame.png"
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full pointer-events-none select-none"
        />
      </div>
    </div>
  </div>
</section>
